# Discord Developer Portal > Bot > Token. Ne jamais versionner le vrai token.
DISCORD_TOKEN=

# Supabase > Project Settings > API. Utiliser la clé service_role côté serveur uniquement.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif : sans cette valeur, AdsCords utilise automatiquement
# https://VOTRE_PROJET.supabase.co/functions/v1/visit
AD_TRACKING_URL=

# Paramètres fonctionnels (les valeurs ci-dessous correspondent au cahier des charges).
BOT_OWNER_ID=1554498783172235345
MAPUB_GUILD_ID=1556728584285196408
COMMAND_PREFIX=.
CLICK_COST_CENTS=10
AUTO_CHANNEL_NAME=ads-cords
